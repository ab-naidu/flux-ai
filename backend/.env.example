# Required for /api/analyze
GEMINI_API_KEY=

# Optional: defaults to gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-pro

# Comma-separated origins for your Lovable / Next.js preview URL
CORS_ORIGINS=http://localhost:3000

# Unkey: set UNKEY_ENABLED=false for local testing without verifying keys
UNKEY_ENABLED=true
UNKEY_VERIFY_URL=https://api.unkey.dev/v1/keys.verify

# Set true when you wire Railtracks SDK in app/services/railtracks.py
RAILTRACKS_ENABLED=false

# Optional: receive JSON span events (start/end) for demos / Railtracks-compatible sinks
RAILTRACKS_WEBHOOK_URL=

# Leave empty to use in-process mock ERP response; or set to full URL of /mock/vori/receiving on your public API
MOCK_INVENTORY_URL=
